# AI Employee Configuration - All Tiers

# ============================================================================
# BRONZE TIER - Base Configuration
# ============================================================================

# Vault Configuration
VAULT_PATH=./AI_Employee_Vault
CHECK_INTERVAL=60
DRY_RUN=false
LOG_LEVEL=INFO

# ============================================================================
# SILVER TIER - Extended Configuration
# ============================================================================

# Gmail Configuration
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_CHECK_INTERVAL=120
GMAIL_QUERY=is:unread is:important

# Priority Keywords (M1 Clarification)
# Comma-separated list of keywords to detect important emails
PRIORITY_KEYWORDS=urgent,important,asap,invoice,payment,client,deadline,action required,critical,emergency
# Matching rules:
# - Case-insensitive matching (e.g., "URGENT" matches "urgent")
# - Searches both subject AND body
# - Whole word matching (e.g., "urgent" does NOT match "urgently")
# - Boolean logic: ANY keyword match triggers priority (OR logic)
PRIORITY_MATCH_CASE_SENSITIVE=false
PRIORITY_MATCH_LOCATION=subject_and_body
PRIORITY_MATCH_WHOLE_WORD=true
PRIORITY_MATCH_LOGIC=any

# Retry Configuration (M3 Clarification)
# Exponential backoff: delay = (RETRY_BACKOFF_BASE ** attempt) + random(0, RETRY_JITTER_MAX)
# Example: attempt 1 = 1s + jitter, attempt 2 = 2s + jitter, attempt 3 = 4s + jitter
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
RETRY_JITTER_MAX=1.0
# Max total wait time across all retries (seconds)
RETRY_MAX_TOTAL_WAIT=30
# Different backoff for rate limits (longer delays)
RETRY_RATE_LIMIT_BACKOFF_BASE=5
RETRY_RATE_LIMIT_MAX_RETRIES=5

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./whatsapp_session
WHATSAPP_CHECK_INTERVAL=30
WHATSAPP_HEADLESS=true

# LinkedIn Configuration
LINKEDIN_SESSION_PATH=./linkedin_session
LINKEDIN_HEADLESS=true

# Email Processing
EMAIL_SIGNATURE="Best regards,\nYour Name\nYour Title\nCompany Name"
EMAIL_RESPONSE_DELAY=300

# Approval Workflow
APPROVAL_CHECK_INTERVAL=60
APPROVAL_EXPIRATION_HOURS=24
APPROVAL_NOTIFICATION=true

# Task Scheduling
MAX_ITERATIONS=10

# ============================================================================
# GOLD TIER - Business Integration (Future)
# ============================================================================

# Odoo Accounting
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Social Media
FACEBOOK_ACCESS_TOKEN=your_token_here
INSTAGRAM_ACCESS_TOKEN=your_token_here
TWITTER_API_KEY=your_key_here
TWITTER_API_SECRET=your_secret_here

# ============================================================================
# PLATINUM TIER - Cloud Deployment (Future)
# ============================================================================

# Cloud Configuration
CLOUD_VAULT_SYNC=false
CLOUD_VM_URL=https://your-vm-url.com
CLOUD_API_KEY=your_cloud_api_key

# ============================================================================
# ERROR RECOVERY SYSTEM
# ============================================================================

# Retry Policy Configuration
# Automatic retry with exponential backoff for transient failures
ERROR_RECOVERY_BASE_DELAY=1.0
ERROR_RECOVERY_MAX_ATTEMPTS=5
ERROR_RECOVERY_MAX_DELAY=60.0
ERROR_RECOVERY_BACKOFF_MULTIPLIER=2.0
ERROR_RECOVERY_JITTER_ENABLED=true
ERROR_RECOVERY_JITTER_MAX=1.0

# Circuit Breaker Configuration
# Prevents cascading failures by opening circuit after sustained failures
ERROR_RECOVERY_CIRCUIT_FAILURE_THRESHOLD=5
ERROR_RECOVERY_CIRCUIT_COOLDOWN_SECONDS=60

# Service Health Configuration
# Auto-restart for failed critical services
ERROR_RECOVERY_RESTART_WINDOW_MINUTES=10
ERROR_RECOVERY_MAX_RESTARTS=3
ERROR_RECOVERY_STABILITY_PERIOD_MINUTES=5

# Alert Configuration
# Rate limiting for degradation alerts
ERROR_RECOVERY_ALERT_RATE_LIMIT_MINUTES=5

# State Persistence
ERROR_RECOVERY_STATE_PATH=./AI_Employee_Vault/.state/recovery_state.json

# ============================================================================
# GENERAL SETTINGS
# ============================================================================

# Logging
LOG_RETENTION_DAYS=30
MAX_LOG_SIZE=10485760

# Notifications
NOTIFICATION_EMAIL=your@email.com

# Security
BACKUP_PATH=./backups
