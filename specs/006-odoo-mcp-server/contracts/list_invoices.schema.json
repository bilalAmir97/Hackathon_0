{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "List Invoices Tool",
  "description": "MCP tool for querying invoices with filters (no approval required - read-only)",
  "type": "object",
  "properties": {
    "date_from": {
      "type": "string",
      "format": "date",
      "description": "Filter invoices from this date (inclusive, optional)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_to": {
      "type": "string",
      "format": "date",
      "description": "Filter invoices to this date (inclusive, optional)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "customer_id": {
      "type": "integer",
      "description": "Filter by customer (Odoo partner ID, optional)",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "posted", "paid", "cancel"],
      "description": "Filter by invoice status (optional)"
    },
    "limit": {
      "type": "integer",
      "description": "Maximum number of results to return (default: 100, max: 1000)",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "offset": {
      "type": "integer",
      "description": "Number of records to skip for pagination (default: 0)",
      "minimum": 0,
      "default": 0
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "date_from": "2026-03-01",
      "date_to": "2026-03-31",
      "status": "posted",
      "limit": 50
    },
    {
      "customer_id": 45,
      "status": "paid"
    },
    {
      "date_from": "2026-01-01",
      "limit": 100,
      "offset": 100
    }
  ],
  "response": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["success", "error"],
        "description": "Operation status"
      },
      "count": {
        "type": "integer",
        "description": "Number of invoices returned"
      },
      "total_count": {
        "type": "integer",
        "description": "Total number of invoices matching filters (for pagination)"
      },
      "invoices": {
        "type": "array",
        "description": "List of invoices",
        "items": {
          "type": "object",
          "properties": {
            "invoice_id": {
              "type": "integer",
              "description": "Odoo invoice ID"
            },
            "invoice_number": {
              "type": "string",
              "description": "Invoice number (e.g., INV/2026/0001)"
            },
            "customer_id": {
              "type": "integer",
              "description": "Customer ID"
            },
            "customer_name": {
              "type": "string",
              "description": "Customer name"
            },
            "date": {
              "type": "string",
              "format": "date",
              "description": "Invoice date"
            },
            "due_date": {
              "type": "string",
              "format": "date",
              "description": "Due date"
            },
            "total_amount": {
              "type": "string",
              "description": "Total amount (masked as '***' in logs)"
            },
            "status": {
              "type": "string",
              "enum": ["draft", "posted", "paid", "cancel"],
              "description": "Invoice status"
            },
            "outstanding_balance": {
              "type": "string",
              "description": "Outstanding balance (masked as '***' in logs)"
            }
          }
        }
      },
      "message": {
        "type": "string",
        "description": "Human-readable status message"
      },
      "error": {
        "type": "string",
        "description": "Error message if status is 'error'"
      }
    },
    "required": ["status", "message"]
  }
}
