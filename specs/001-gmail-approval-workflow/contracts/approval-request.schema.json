{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hackathon0.ai-employee/schemas/approval-request.json",
  "title": "Approval Request",
  "description": "Schema for approval request files (supports email, WhatsApp, social media, and other approval types)",
  "type": "object",
  "required": [
    "approval_id",
    "action_type"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "description": "Unique approval identifier"
    },
    "action_type": {
      "type": "string",
      "description": "Type of action requiring approval",
      "enum": [
        "email_send",
        "whatsapp_reply",
        "facebook_post_text",
        "facebook_post_image",
        "instagram_post_image",
        "instagram_post_carousel",
        "twitter_post_tweet",
        "twitter_post_thread",
        "payment",
        "api_call"
      ]
    },
    "operation": {
      "type": "string",
      "description": "Operation type (for Odoo operations)",
      "enum": ["invoice", "payment"]
    },
    "email_action_ref": {
      "type": "string",
      "description": "Reference to Email Action Item (optional, for email_send only)"
    },
    "action_params": {
      "type": "object",
      "description": "Parameters for action execution (optional)"
    },
    "risk_assessment": {
      "type": "string",
      "description": "Risk level for this action",
      "enum": ["low", "medium", "high"]
    },
    "reasoning": {
      "type": "string",
      "description": "Why this action is needed"
    },
    "alternatives_considered": {
      "type": "array",
      "description": "Other approaches evaluated",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "description": "Approval request creation timestamp",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "description": "Approval expiration timestamp",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "description": "Current approval status",
      "enum": ["pending", "approved", "rejected", "expired"]
    },
    "approved_at": {
      "type": "string",
      "description": "Approval timestamp (if approved)",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "description": "Human approver identifier"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection (if rejected)"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the approval"
    }
  }
}
